# Ohne Schlüssel startet die App automatisch im Demo-Modus (Spec 47).
# LLM_PROVIDER: auto | openai | nvidia | compatible | fixture
LLM_PROVIDER=auto

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-5-mini
OPENAI_MODEL_MAIN=gpt-5-mini

# --- NVIDIA NIM (OpenAI-kompatibel, kostenloses Kontingent) ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_MODEL_MAIN=nvidia/nemotron-3.5-lightning-30b-a3b

# --- Hermes-Agent-CLI (Schlüssel liegt in ~/.hermes/.env, nicht hier) ---
# npm run set-key -- --hermes
HERMES_BIN=hermes
HERMES_PROVIDER=nvidia
HERMES_MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
HERMES_MODEL_MAIN=nvidia/nemotron-3.5-lightning-30b-a3b

# --- Websuche über Hermes (ADR-016) — schlüsselfrei über DuckDuckGo ---
# Einmalig: VIRTUAL_ENV="$HOME/.hermes/hermes-agent/venv" uv pip install ddgs
# SEARCH_PROVIDER=hermes
# HERMES_HOME=                     # nur nötig, wenn Hermes nicht unter ~/.hermes liegt
HERMES_SEARCH_BACKEND=ddgs

# --- Langsame Reasoning-Modelle (ADR-018) ---
# auto = nur bei NVIDIA abschalten; on = immer; off = nie
LLM_DISABLE_THINKING=auto

# --- Beliebiger OpenAI-kompatibler Endpunkt (Groq, Together, OpenRouter, Ollama, vLLM) ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_FAST=
LLM_MODEL_MAIN=
SEARCH_PROVIDER=auto
BRAVE_API_KEY=
TAVILY_API_KEY=
DATABASE_PATH=./data/app.db
DEMO_MODE=
AUTH_ENABLED=false
MAX_RUN_COST_USD=0.5
MAX_RUN_WALL_CLOCK_MS=180000
MAX_RESEARCH_ITERATIONS=3
MAX_SEARCHES=12
MAX_SOURCES=15
FETCH_TIMEOUT_MS=8000
RATE_LIMIT_RUNS_PER_HOUR=30
LOG_LEVEL=info
SHOW_COSTS=false
